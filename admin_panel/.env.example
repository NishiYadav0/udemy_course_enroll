# admin_panel/.env.example
# --------------------------
# Template only — safe to commit. The real admin_panel/.env (with a real
# SECRET_KEY and password hash) must NEVER be committed.
#
# Don't hand-edit this into place. Run set_password.py instead — it
# generates SECRET_KEY and the password hash correctly.

SECRET_KEY=replace-me-with-64-random-hex-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-me-generated-by-set_password.py
SCHOLARSYNC_ROOT=/home/ubuntu/scholarsync
SERVICE_NAME=scholarsync
SESSION_TIMEOUT_MINUTES=120
BEHIND_HTTPS=true
