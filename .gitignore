# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
venv/
.venv/
env/

# Pyrogram session files (contain your login - VERY sensitive)
*.session
*.session-journal

# Secret environment file (and the timestamped backups apply_cookies.py makes)
.env
.env.backup-*

# Raw cookie dumps exported from DevTools — these are LIVE credentials for
# your Udemy account. Never commit them.
cookies.txt
*cookies*.txt

# Debug captures from the enrollment browser. These show a logged-in Udemy
# session (account name, email, purchase history) — never commit them.
enroll_*.png
enroll_*.html
checkout_state*.png
cart_debug.png
debug_output.txt

# Chrome profile the bot builds on the server (holds its earned cf_clearance)
.scholarsync_browser/

# Scratch files
*.tmp

# One-off investigation scripts written while reverse-engineering Udemy's
# checkout. They have hardcoded course ids / coupons / a personal user id and
# are fully superseded by test_enrollment.py. Safe to delete entirely.
check_cookies.py
debug_cart.py
debug_enroll.py
find_endpoint.py

# Editor settings
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Website-polling state (local, regenerable, not sensitive but not
# meant to be committed)
seen_courses.json

# Coupon retry queue state (local, regenerable)
retry_queue.json

# Internal/personal working docs — contain real VM IPs, timestamps, and
# session-specific notes from development. Not meant for the public repo.
# README.md carries a sanitized, public-facing version of the same story.
# (Test/diagnostic scripts and the poller_main.py alternate architecture
# ARE kept in the repo on purpose — see README.md's file structure section.)
ORACLE_DEPLOYMENT_GUIDE.md
PROGRESS_REPORT.md
IMPLEMENTATION_PLAN.md
task.md

# Persistent record of courses you already own (personal enrollment history,
# regenerates itself, and self-heals after 30 days)
enrolled_courses.json
