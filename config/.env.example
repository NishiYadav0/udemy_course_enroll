# ============================================================
# ScholarSync - Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to: .env  (remove the .example)
#   2. Replace every placeholder value with your REAL values
#   3. NEVER share the .env file or push it to GitHub
# ============================================================

# ---- Telegram Developer Portal (from my.telegram.org) -----
# Your App API ID (7-8 digit integer)
API_ID=12345678

# Your App API Hash (32-character string)
API_HASH=your_32_character_api_hash_here

# ---- Telegram Channel Configuration ---------------------
# Comma-separated Chat IDs of the coupon channels to monitor
# These are the channels you have already JOINED in your Telegram app
TARGET_CHANNELS=-1000000000000,-1000000000001

# The Chat ID of YOUR private, UNMUTED notification channel
# This is where ScholarSync sends enrollment confirmations
ALERT_CHANNEL_ID=-1000000000002

# ---- Udemy Authentication (from browser developer tools) ----
# HOW TO CAPTURE ALL OF THESE AT ONCE:
#   1. Log in to udemy.com in Chrome
#   2. F12 → Application tab → Storage → Cookies → https://www.udemy.com
#   3. Copy each value below by cookie name (paste the value only, no quotes)
#
# IMPORTANT — why the extra cookies matter:
#   access_token alone authenticates Udemy's JSON API (api-2.0), which is why
#   course lookups work with just it. But the /payment/checkout/ page is a
#   server-rendered Django page: without dj_session_id + ud_user_jwt it renders
#   the anonymous "Log in or create an account" checkout and enrollment can
#   NEVER complete, no matter how valid the coupon is.

# Cookie: access_token   (the "Bearer " prefix is optional; quotes are stripped)
UDEMY_ACCESS_TOKEN=your_udemy_access_token_here

# Cookie: csrftoken      (required for any POST/write request)
UDEMY_CSRF_TOKEN=your_csrftoken_here

# Cookie: dj_session_id  (Django session — REQUIRED for the checkout page)
UDEMY_DJ_SESSION_ID=your_dj_session_id_here

# Cookie: ud_user_jwt    (REQUIRED for the checkout page)
UDEMY_USER_JWT=your_ud_user_jwt_here

# Cookie: client_id
UDEMY_CLIENT_ID=your_client_id_here

# Cookie: ud_cache_user  (your numeric Udemy user ID)
UDEMY_USER_ID=123456789

# ---- Cloudflare bypass cookies ------------------------------
# Cookie: cf_clearance
# WARNING: cf_clearance is bound to BOTH your IP address AND the exact
# User-Agent string of the browser that generated it. A cf_clearance captured
# on your home PC will NOT work from your Oracle VM (different IP), and will
# not work if UDEMY_USER_AGENT below doesn't match byte-for-byte.
UDEMY_CF_CLEARANCE=your_cf_clearance_here

# Cookie: __cf_bm — short-lived, expires roughly 30 MINUTES after capture.
# Expect to refresh this often; it is optional and can be left blank.
UDEMY_CF_BM=

# The EXACT User-Agent of the browser you captured cf_clearance from.
# Get it by typing this in that browser's DevTools Console:  navigator.userAgent
# Must match character-for-character or Cloudflare rejects cf_clearance.
UDEMY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# ---- Website-Polling Mode (poller_main.py) -------------------
# Used only by poller_main.py, NOT main.py. How often (in seconds) to
# check freecourse.io and findmycourse.in for newly published courses.
# Kept moderate on purpose — see utils/poller.py for why fast polling
# isn't appropriate for these sites. 240 = every 4 minutes.
POLL_INTERVAL_SECONDS=240
