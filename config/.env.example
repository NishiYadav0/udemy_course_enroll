# ============================================================
# ScholarSync - Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to: .env  (remove the .example)
#   2. Replace every placeholder value with your REAL values
#   3. NEVER share the .env file or push it to GitHub
# ============================================================

# ---- Telegram Developer Portal (from my.telegram.org) -----
# Your App API ID (7-8 digit integer)
API_ID=12345678

# Your App API Hash (32-character string)
API_HASH=your_32_character_api_hash_here

# ---- Telegram Channel Configuration ---------------------
# Comma-separated Chat IDs of the coupon channels to monitor
# These are the channels you have already JOINED in your Telegram app
TARGET_CHANNELS=-1000000000000,-1000000000001

# The Chat ID of YOUR private, UNMUTED notification channel
# This is where ScholarSync sends enrollment confirmations
ALERT_CHANNEL_ID=-1000000000002

# ---- Udemy Authentication (from browser developer tools) ----
# Get this from: Udemy.com → F12 → Application → Cookies → access_token
# MUST include the word "Bearer " before the token string
UDEMY_ACCESS_TOKEN=Bearer your_udemy_access_token_here

# ---- Website-Polling Mode (poller_main.py) -------------------
# Used only by poller_main.py, NOT main.py. How often (in seconds) to
# check freecourse.io and findmycourse.in for newly published courses.
# Kept moderate on purpose — see utils/poller.py for why fast polling
# isn't appropriate for these sites. 240 = every 4 minutes.
POLL_INTERVAL_SECONDS=240
